# Generate with: npm run auth:hash
APP_PASSWORD_HASH=

# Generate with: npm run auth:hash
ADMIN_PASSWORD_HASH=

# Generate with: npm run auth:secret
SESSION_SECRET=

# Existing Google Spreadsheet shared with the service account.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service Account JSON: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service Account JSON: private_key (actual line breaks or escaped \n are accepted)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
